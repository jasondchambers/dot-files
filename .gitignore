# Generated by install.sh — OS-specific symlink, not tracked
ghostty/config
.DS_Store

# Contains secret environment IDs — never commit
.zshrc.secrets

# Karabiner runtime files (whole ~/.config/karabiner dir is symlinked)
karabiner/automatic_backups/
karabiner/assets/
karabiner/*.bak

# Local Claude Code session-resume helper
hypr/resume.sh

# Generated by DankMaterialShell (Matugen theming) — machine-specific, not required by hyprland.lua
hypr/dms/
ghostty/themes/dankcolors

# DankMaterialShell runtime files (whole ~/.config/DankMaterialShell dir is symlinked)
dms/.firstlaunch
dms/.changelog-*
dms/firefox.css
