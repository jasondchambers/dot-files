# Ghostty config — ported from wezterm/wezterm.lua.macos

# Font
font-family = MesloLGS Nerd Font Mono
font-size = 14

# coolnight color scheme
foreground = #CBE0F0
background = #011423
cursor-color = #47FF9C
cursor-text = #011423
selection-background = #214969
selection-foreground = #CBE0F0
split-divider-color = #24EAF7
palette = 0=#214969
palette = 1=#E52E2E
palette = 2=#44FFB1
palette = 3=#FFE073
palette = 4=#0FC5ED
palette = 5=#a277ff
palette = 6=#24EAF7
palette = 7=#24EAF7
palette = 8=#214969
palette = 9=#E52E2E
palette = 10=#44FFB1
palette = 11=#FFE073
palette = 12=#A277FF
palette = 13=#a277ff
palette = 14=#24EAF7
palette = 15=#24EAF7

# Dim inactive panes
unfocused-split-opacity = 0.4
unfocused-split-fill = #011423

# macOS Option key as Alt (not compose)
macos-option-as-alt = true

# Window
window-padding-x = 14
window-padding-y = 14
background-opacity = 0.8
background-blur = 20
# No separate titlebar; tabs live in the titlebar area (closest to WezTerm's
# RESIZE decorations + retro tab bar). Use "hidden" to drop the tab bar too.
macos-titlebar-style = tabs
window-theme = ghostty
macos-non-native-fullscreen = false
window-width = 120
window-height = 40

# Term
term = xterm-256color

# Keybindings
keybind = f11=toggle_fullscreen
keybind = alt+f=toggle_fullscreen

# Pane navigation. Ghostty can't inspect the foreground process like WezTerm
# did, so "performable:" is used instead: the key is only consumed when there
# is a split in that direction, otherwise it passes through to nvim/the shell.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# Leader key (tmux-style: Ctrl+B) — implemented as key sequences
# Panes
keybind = ctrl+b>shift+backslash=new_split:right
keybind = ctrl+b>minus=new_split:down
keybind = ctrl+b>z=toggle_split_zoom
keybind = ctrl+b>m=toggle_split_zoom
keybind = ctrl+b>x=close_surface

# Tabs (windows in tmux terms)
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

# Jump to tab by number (like tmux <leader>0-9)
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = ctrl+b>7=goto_tab:7
keybind = ctrl+b>8=goto_tab:8
keybind = ctrl+b>9=goto_tab:9

# GitHub
keybind = ctrl+b>g=text:open-gh\n

# Copy mode — Ghostty has no vi-style copy mode; search the scrollback instead
keybind = ctrl+b>bracket_left=start_search
